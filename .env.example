# NameSweep environment configuration
# Copy to .env and edit. The .env file is gitignored — never commit it.

# App
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
APP_TIMEZONE=America/Santo_Domingo
LOG_LEVEL=INFO

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=namesweep
DB_USER=namesweep
DB_PASS=changeme

# Cache TTLs (hours)
TTL_DOMAIN=24
TTL_MARKETPLACE=24
TTL_SOCIAL=168
TTL_TRADEMARK=720

# HTTP
HTTP_TIMEOUT_SECONDS=8
HTTP_USER_AGENT=NameSweep/1.0 (+https://github.com/jimmyraymour/namesweep)

# LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:3b — smaller/quieter than llama3.1:8b on 8 GB hosts
OLLAMA_MODEL=qwen2.5:3b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Suggest mode
SUGGEST_MAX_ITERATIONS=5
SUGGEST_TEMPERATURE=0.7
SUMMARY_TEMPERATURE=0.2

# Aftermarket
OPENPROVIDER_API_URL=https://api.openprovider.com/v1beta
OPENPROVIDER_API_KEY=
# Primary RobotDomainSearch tier (unverified/down as of 2026-08-17; adjust once confirmed live)
ROBOTDOMAINSEARCH_AVAILABILITY_URL=https://api.robotdomainsearch.com/availability?domain={domain}
ROBOTDOMAINSEARCH_AFTERMARKET_URL=https://api.robotdomainsearch.com/v1/aftermarket?domain={domain}
# Parallel fan-out cap for marketplace checks (default 5)
AFTERMARKET_CONCURRENCY=5

# RDAP
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_BOOTSTRAP_CACHE=storage/cache/rdap_bootstrap.json

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Meridian — the operator's portfolio tracker. Reporting into it is mandatory
# for every agent working on this repo; see AGENT_RULES.md.
# The key is project-scoped and issued by the operator. Ask for it, or re-fetch
# the guide with a key you already have:
#   curl -H "X-MC-Key: $MERIDIAN_API_KEY" $MERIDIAN_API_URL/guide -o MERIDIAN_GUIDE.md
MERIDIAN_API_URL=http://localhost/meridian/api
MERIDIAN_PROJECT_ID=namesweep
MERIDIAN_TRACKER=dev
MERIDIAN_API_KEY=
